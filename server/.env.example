# Copy this file to .env and fill in your values.

PORT=5000

# Local MongoDB, or paste your MongoDB Atlas connection string.

MONGODB_URI= your_connectio_string


# Any long random string (used to sign login tokens).
JWT_SECRET=


CLIENT_URL=http://localhost:8080

# Optional: SMTP settings to send real verification emails.
# If SMTP_HOST is empty, the verification code is printed in this terminal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your_mail>
SMTP_PASS=
EMAIL_FROM=TaskMaster <no-reply@taskmaster.local>